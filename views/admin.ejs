<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Yukihira Diner - Admin Dashboard</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <aside class="admin-sidebar">
        <h2>Yukihira Admin</h2>
        <ul>
            <li><a href="/admin" class="active">📊 Manage Menu</a></li>
            <li><a href="/">🏠 Back to Website</a></li>
            <li>
                <form action="/admin/logout" method="POST">
                    <button type="submit" class="logout-link">🚪 Logout</button>
                </form>
            </li>
        </ul>
    </aside>

    <main class="admin-main">
        <header class="admin-header">
            <h1>Restaurant Control Panel</h1>
            <span class="admin-user">Chef: <strong>Soma Yukihira</strong></span>
        </header>

        <section class="admin-section" style="margin-bottom: 2rem;">
            <h2>Add New Recipe</h2>
            <p>Images up to 10 MB are uploaded and optimized asynchronously by a background worker.</p>
            <form action="/admin/dishes/add" method="POST" enctype="multipart/form-data" class="add-form">
                <input type="text" name="name" placeholder="Dish Name (e.g., Souffle Omelet)" maxlength="120" required>
                <input type="text" name="category" placeholder="Category (e.g., Main Course)" maxlength="60" required>
                <input type="number" step="0.01" min="0" name="price" placeholder="Price ($)" required>
                <label for="image">Dish image (JPG, PNG, WebP; max 10 MB)</label>
                <input id="image" type="file" name="image" accept="image/jpeg,image/png,image/webp" required>
                <textarea name="description" placeholder="Dish description..." maxlength="2000" required></textarea>
                <button type="submit" class="btn-primary">Add to Menu</button>
            </form>
        </section>

        <section class="admin-section">
            <h2>Current Menu Inventory</h2>
            <table class="admin-table">
                <thead>
                    <tr><th>Image</th><th>Name</th><th>Category</th><th>Price</th><th>Image Status</th><th>Action</th></tr>
                </thead>
                <tbody>
                    <% dishes.forEach(dish => { %>
                        <tr>
                            <td>
                                <% if (dish.image) { %>
                                    <img src="<%= dish.image %>" alt="<%= dish.name %>" width="50" style="border-radius: 4px;">
                                <% } %>
                            </td>
                            <td><%= dish.name %></td>
                            <td><%= dish.category %></td>
                            <td>$<%= Number(dish.price).toFixed(2) %></td>
                            <td>
                                <% if (dish.imageStatus === "processing") { %>
                                    <span>⏳ Processing</span>
                                <% } else if (dish.imageStatus === "completed") { %>
                                    <span>✅ Completed</span>
                                <% } else if (dish.imageStatus === "failed") { %>
                                    <span title="<%= dish.imageError || 'Processing failed' %>">❌ Failed</span>
                                <% } else { %>
                                    <span>—</span>
                                <% } %>
                            </td>
                            <td>
                                <a href="/admin/dishes/<%= dish._id %>/edit">Edit</a>
                                <form action="/admin/dishes/delete/<%= dish._id %>" method="POST" style="display:inline;">
                                    <button type="submit" class="btn-delete">Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </section>
    </main>
</body>
</html>
